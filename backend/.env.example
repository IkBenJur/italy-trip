# --- database ---
GOOSE_DBSTRING="host=localhost port=5432 user=postgres password=postgres dbname=italy-trip sslmode=disable"
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=./internal/postgres/migrations

PORT=8080

# --- auth (required: the server refuses to boot without JWT_SECRET) ---
JWT_SECRET=dev-secret-change-me
JWT_TTL_HOURS=720

# --- the single shared login, seeded on boot (required) ---
SEED_USER_EMAIL=us@example.com
SEED_USER_PASSWORD=change-me-please

# --- optional, defaults exist in code ---
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=15728640

# --- Railway Storage Bucket (read natively by the AWS SDK, except the bucket name) ---
# Locally these point at the MinIO service in docker-compose.yaml; on Railway
# they are wired to the italy-trip-bucket-prod service variables.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:9000
AWS_S3_BUCKET_NAME=italy-trip
# MinIO needs path-style addressing; leave unset (false) for Railway unless the
# storage integration test says otherwise.
AWS_S3_USE_PATH_STYLE=true
